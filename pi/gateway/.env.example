# Copy to /etc/drowning/gateway.env for systemd, then adjust device addresses.
GATEWAY_ID=gateway-01
DRONE_ID=drone-01
INPUT_MODE=lora_serial
SERVER_URL=http://127.0.0.1:8001
REQUEST_TIMEOUT=5
MAX_RETRIES=3
SEND_INTERVAL=2
DRY_RUN=false

LORA_SERIAL_PORT=/dev/ttyUSB0
LORA_SERIAL_BAUD_RATE=115200
LORA_SERIAL_TIMEOUT_SEC=1
FC_SERIAL_PORT=/dev/serial0
FC_BAUD_RATE=115200
FC_RECONNECT_DELAY_SEC=3
FC_POSITION_MAX_AGE_SEC=3

DETECTION_MODE=fpga
DETECTION_COOLDOWN_SEC=60
CAMERA_ENABLED=false
CAMERA_HOLD_SECONDS=20
CAMERA_WIDTH=854
CAMERA_HEIGHT=480
CAMERA_FPS=10
CAMERA_BITRATE=800000
CAMERA_RTSP_URL=rtsp://127.0.0.1:8554/drone
