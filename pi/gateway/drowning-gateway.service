[Unit]
Description=Drowning drone Raspberry Pi gateway
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/drowning/pi/gateway
EnvironmentFile=/etc/drowning/gateway.env
ExecStart=/opt/drowning/pi/gateway/.venv/bin/python main.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
