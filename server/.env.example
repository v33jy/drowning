# Server process settings (load with systemd EnvironmentFile or export manually).
CORS_ORIGINS=*
WS_SEND_TIMEOUT_SECONDS=2

# Operation grid.
GRID_LAT_MIN=37.49625
GRID_LAT_MAX=37.50875
GRID_LNG_MIN=127.02212178363473
GRID_LNG_MAX=127.03787821636527
GRID_ROWS=10
GRID_COLS=10
# GRID_LANDMARKS={"F2":"교보타워 인근","E5":"국기원 인근"}
# GRID_PRIORITIES_FILE=/absolute/path/to/grid_priorities.json

# Search tuning and bounded in-memory history.
SEARCH_RECENT_WINDOW=10
SEARCH_RECHECK_RSS_DBM=-65
SEARCH_RECHECK_MIN_SAMPLES=3
SEARCH_CANDIDATE_MIN_SCORE=0.55
SEARCH_RSS_FLOOR_DBM=-100
SEARCH_RSS_CEILING_DBM=-40
MAX_SIGNAL_READINGS=10000

# MediaMTX endpoint advertised to clients.
# MEDIAMTX_WHEP_URL=http://192.168.0.20:8889/drone/whep
MEDIAMTX_WHEP_PORT=8889
